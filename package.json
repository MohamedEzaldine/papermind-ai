{
  "name": "papermind-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx server/evidence.test.ts && tsx server/ollama.test.ts && tsx server/retrieval.test.ts",
    "build:desktop-server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --outfile=electron/server.mjs --external:vite --external:electron \"--banner:js=import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "desktop": "npm run build && npm run build:desktop-server && electron .",
    "dist:win": "npm run build && npm run build:desktop-server && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "unpdf": "^1.9.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "PaperMind AI - smart research paper analyzer with page-level, verified evidence",
  "author": "Mohamed Ezaldine",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.papermind.ai",
    "productName": "PaperMind AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/main.mjs",
      "electron/server.mjs",
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaperMind AI",
      "include": "build/installer.nsh",
      "artifactName": "PaperMind-AI-Setup-${version}.${ext}"
    }
  }
}
