# Gemini API key (free from https://aistudio.google.com/apikey).
# Keep it on the server only: never commit a real .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# Optional: port for the server (default 3000)
# PORT=3000
