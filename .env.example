# Which AI engine to use: "ollama" (local, no key) or "gemini" (cloud).
# If not set: Gemini is used when GEMINI_API_KEY is present, otherwise local Ollama.
# AI_PROVIDER="ollama"

# --- Local engine (Ollama) ---
# OLLAMA_HOST="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen2.5:7b"
# OLLAMA_NUM_CTX=32768

# --- Cloud engine (Gemini) ---
# Free key from https://aistudio.google.com/apikey. Keep it on the server only.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash"

# PORT=3000
